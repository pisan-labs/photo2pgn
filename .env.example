# Public client values (platform/supabase.json in pisanuw/claude-built-apps).
# Public by design: the anon key only reaches rows that row level security
# allows. Vite reads VITE_* at build time; netlify.toml sets them for builds.
VITE_SUPABASE_URL=https://auth.hintwise.org
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImFya3R4bHJseWNlZmZ5b3pkd2hxIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NzY4ODEwMTAsImV4cCI6MjA5MjQ1NzAxMH0.Vuku-irT3kAHZYibK23q6dpyOEqV_Eg5zB78I3dyshE

# Paddle (buying credits). Build settings, public by design: the client-side
# token (live_... for the live account, test_... for the sandbox; its prefix
# picks which) and the price id of each pack. Nothing is for sale until all
# are set. Set them on Netlify, not here.
VITE_PADDLE_CLIENT_TOKEN=
VITE_PADDLE_PRICE_PACK_20=
VITE_PADDLE_PRICE_PACK_50=
# Server settings (Netlify, secret): the notification destination's signing
# secret (endpoint_secret_key), and the same price ids for the webhook.
# photo2pgn never calls Paddle's API, so no Paddle API key is needed.
PGN_PADDLE_WEBHOOK_SECRET=
PGN_PADDLE_PRICE_PACK_20=
PGN_PADDLE_PRICE_PACK_50=
