{
  "name": "Photo to PGN",
  "short_name": "Photo2PGN",
  "description": "Turn a photo of a handwritten chess scoresheet into a PGN file.",
  "id": "/",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#f6f5f1",
  "theme_color": "#1f3a5f",
  "icons": [
    { "src": "/icons/hintwise-icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "/icons/hintwise-icon-512.png", "sizes": "512x512", "type": "image/png" }
  ],
  "share_target": {
    "action": "/share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": { "files": [{ "name": "photos", "accept": ["image/*"] }] }
  }
}
